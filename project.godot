; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ExplosionSquadGame"
run/main_scene="uid://c0m784riw25wo"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
run/flush_stdout_on_print=true
run/load_shell_environment=true
boot_splash/bg_color=Color(0.01907944, 0.31334987, 0.38034695, 1)
boot_splash/image="uid://cb0g3nsaa2vac"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=1000

[autoload]

Global="*uid://c4sihd8rawspw"

[debug]

settings/stdout/print_fps=true
settings/stdout/print_gpu_profile=true

[display]

window/size/viewport_width=780
window/size/viewport_height=1080
window/size/initial_position_type=4
window/size/always_on_top=true
window/hdr/request_hdr_output=true
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="ExplosionSquadGame"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true

